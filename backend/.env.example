# Safe sample values only. Copy to backend/.env for local development;
# the app reads RELAY_* variables, everything else is ignored.

# Read-only role used by the API (never superuser, never the migration role).
RELAY_DATABASE_URL=postgresql+psycopg://relay_app@127.0.0.1:5433/relay_dev

# Admin/migration role (seeding and Alembic only).
RELAY_ADMIN_DATABASE_URL=postgresql+psycopg://relay_admin@127.0.0.1:5433/relay_dev

# Demo principal: comma-separated account ids the trusted admin may inspect.
# Empty means every fixture account (the take-home demo default).
RELAY_ALLOWED_ACCOUNT_IDS=

# Fixture clock and assumed recording interval (documented demo assumptions).
RELAY_DEMO_NOW=2026-07-28T12:00:00+00:00
RELAY_COVERAGE_START=2026-02-01T00:00:00+00:00
RELAY_COVERAGE_END=2026-07-28T00:00:00+00:00
